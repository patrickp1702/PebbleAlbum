{
  "name": "pebble-album",
  "version": "1.0.0",
  "description": "PebbleAlbum — a world-class desktop photo album creation studio.",
  "author": "PebbleAlbum Studio",
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "echo \"(add eslint if desired)\"",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.config.cjs",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.config.cjs",
    "dist:linux": "npm run build && electron-builder --linux --config electron-builder.config.cjs"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@imgly/background-removal-node": "^1.4.5",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "@vueuse/core": "^11.0.0",
    "fabric": "^6.4.0",
    "ffmpeg-static": "^5.3.0",
    "pdfkit": "^0.15.0",
    "pinia": "^2.2.0",
    "sharp": "^0.33.0",
    "three": "^0.168.0",
    "uuid": "^10.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pdfkit": "^0.13.4",
    "@types/three": "^0.168.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "autoprefixer": "^10.4.20",
    "electron": "^43.2.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.1.0"
  }
}
