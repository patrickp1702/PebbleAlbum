{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/types/*"]
    },
    "types": ["node"]
  },
  "include": [
    "electron/**/*.ts",
    "electron.vite.config.ts",
    "electron-builder.config.cjs",
    "src/types/**/*.ts"
  ],
  "exclude": ["node_modules", "out", "release"]
}
